# Development only. Replace with a random value; never use a production secret.
APP_SECRET=replace-with-random-local-secret

# Optional foreground invoice reading (manual entry works without this key).
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-6-luna
OPENAI_ASSISTANT_MODEL=gpt-6-luna
# Service account JSON inside the /app bind mount, ignored by Git.
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/var/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB="Factures fournisseurs"
