{
  "name": "organic/to-go",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-bcmath": "*",
    "ext-intl": "*",
    "ext-pdo": "*",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.5",
    "symfony/cache": "8.1.*",
    "symfony/clock": "8.1.*",
    "symfony/config": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dependency-injection": "8.1.*",
    "symfony/doctrine-bridge": "8.1.*",
    "symfony/error-handler": "8.1.*",
    "symfony/event-dispatcher": "8.1.*",
    "symfony/filesystem": "8.1.*",
    "symfony/finder": "8.1.*",
    "symfony/form": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/http-foundation": "8.1.*",
    "symfony/http-kernel": "8.1.*",
    "symfony/options-resolver": "8.1.*",
    "symfony/password-hasher": "8.1.*",
    "symfony/property-access": "8.1.*",
    "symfony/property-info": "8.1.*",
    "symfony/rate-limiter": "8.1.*",
    "symfony/routing": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-core": "8.1.*",
    "symfony/security-csrf": "8.1.*",
    "symfony/security-http": "8.1.*",
    "symfony/stopwatch": "8.1.*",
    "symfony/string": "8.1.*",
    "symfony/translation": "8.1.*",
    "symfony/twig-bridge": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/type-info": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/var-dumper": "8.1.*",
    "symfony/var-exporter": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "DoctrineMigrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "description": "Local French restaurant delivery and payment ledger"
}
