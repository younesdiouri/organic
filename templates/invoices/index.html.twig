{% extends 'base.html.twig' %}
{% block title %}Factures fournisseurs{% endblock %}
{% block body %}
<h1>Factures fournisseurs</h1>
<p><a href="{{ path('suppliers') }}">Gérer les fournisseurs et leurs alias</a></p>
<div class="row g-4"><section class="col-lg-5"><h2 class="h4">Ajouter un document</h2>
<p>Photos privées, supprimées après validation. Les brouillons expirent après 24 h. Jusqu’à 6 photos JPEG, PNG ou WebP : 8 Mo chacune, 20 Mo au total.</p>
<p class="small">La lecture transmet les photos à OpenAI si elle est configurée. Le premier document est lu après cet envoi ; les suivants se lisent depuis leur brouillon.</p>
{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-success">Préparer et lire le premier document</button>{{ form_end(form) }}
<form action="{{ path('invoice_manual') }}" method="post" class="mt-3"><input type="hidden" name="_token" value="{{ csrf_token('invoice_manual') }}"><button class="btn btn-outline-success">Saisie manuelle sans photo</button></form>
{% if not aiConfigured %}<p class="alert alert-info mt-3">Lecture automatique non configurée. La saisie manuelle reste disponible.</p>{% endif %}
{% if pending %}<h2 class="h5 mt-3">Brouillons à vérifier</h2><ol>{% for token in pending %}<li><a href="{{ path('invoice_draft', {token:token}) }}">Document {{ loop.index }}</a></li>{% endfor %}</ol>{% endif %}
</section><section class="col-lg-7"><h2 class="h4">Documents validés</h2>
<form method="get" class="d-flex flex-wrap gap-2 mb-3"><label>Du <input class="form-control" type="date" name="start" value="{{ app.request.query.get('start') }}"></label><label>Au <input class="form-control" type="date" name="end" value="{{ app.request.query.get('end') }}"></label><button class="btn btn-outline-success align-self-end">Filtrer</button></form>
<p><strong>Factures : {{ (totals.invoice / 100)|number_format(2, ',', ' ') }} MAD</strong><br>Bons de livraison séparés : {{ (totals.delivery_note / 100)|number_format(2, ',', ' ') }} MAD (non additionnés aux factures).</p>
<a class="btn btn-outline-success" href="{{ path('invoices_csv', {start:app.request.query.get('start'), end:app.request.query.get('end')}) }}">Exporter le CSV filtré</a>
<form action="{{ path('invoices_sheets') }}" method="post" class="my-3"><input type="hidden" name="_token" value="{{ csrf_token('invoices_sheets') }}"><button class="btn btn-outline-success">Envoyer les documents manquants dans Google Sheets</button></form>
<p class="small">Envoi manuel de tous les documents validés, identifiés par leur ID. La base locale reste la référence. {% if not sheetsConfigured %}Google Sheets non configuré. Le CSV est disponible.{% endif %}</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Date / type</th><th>Fournisseur / libellé</th><th>Référence</th><th>TTC MAD</th><th>Validation</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.date }}<br>{{ row.document_kind == 'invoice' ? 'Facture' : 'Bon de livraison' }}</td><td>{{ row.supplier_name }}<br><small>{{ row.reporting_label }}</small></td><td>{{ row.reference }}</td><td>{{ (row.total_cents / 100)|number_format(2, ',', ' ') }}</td><td><small>{{ row.validator }}<br>{{ row.validated_at }} UTC<br>{{ {manual:'Saisie manuelle', extracted:'Lecture confirmée', corrected:'Corrigé'}[row.provenance] }}</small></td></tr>{% else %}<tr><td colspan="5">Aucun document validé.</td></tr>{% endfor %}</tbody></table></div>
</section></div>
{% endblock %}
