{% extends 'base.html.twig' %}{% block body %}
<h1>Fournisseurs</h1><p><a href="{{ draftToken ? path('invoice_draft', {token:draftToken}) : path('invoices') }}">Retour aux documents</a></p>
{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-success">Enregistrer le fournisseur</button>{{ form_end(form) }}
<p class="mt-3">Les alias servent à reconnaître exactement les noms imprimés. En cas d’alias partagé, choisir le fournisseur manuellement. Le libellé interne peut différer de la raison sociale.</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Nom officiel</th><th>Alias</th><th>Libellé interne</th><th></th></tr></thead><tbody>{% for supplier in rows %}<tr><td>{{ supplier.name }}</td><td>{{ supplier.aliases|join(', ') }}</td><td>{{ supplier.reportingLabel }}</td><td><a href="{{ path('supplier_edit', {id:supplier.id, draft:draftToken}) }}">Modifier</a></td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
