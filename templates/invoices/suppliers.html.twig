{% extends 'base.html.twig' %}
{% block body %}
<h1>Fournisseurs</h1>
<p><a href="{{ draftToken ? path('invoice_draft', {token:draftToken}) : path('invoices') }}">Retour aux documents</a></p>
<div class="row g-4">
<aside class="col-lg-4"><div class="card p-3">
<h2 class="h5">{{ editing ? 'Modifier le fournisseur' : 'Ajouter un fournisseur' }}</h2>
{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-success">Enregistrer le fournisseur</button>{{ form_end(form) }}
<p class="mt-3 mb-0 text-secondary">Les alias servent à reconnaître exactement les noms imprimés. En cas d’alias partagé, choisir le fournisseur manuellement. Le libellé interne peut différer de la raison sociale.</p>
</div></aside>
<section class="col-lg-8">
<form method="get" class="card p-3 mb-3">
{% if draftToken %}<input type="hidden" name="draft" value="{{ draftToken }}">{% endif %}
<label for="q" class="form-label">Rechercher un fournisseur</label>
<div class="d-flex gap-2"><input id="q" name="q" class="form-control" value="{{ query }}" placeholder="Nom, alias ou libellé interne"><button class="btn btn-outline-success">Rechercher</button></div>
</form>
<p class="text-secondary">{{ rows|length }} fournisseur{{ rows|length != 1 ? 's' }} affiché{{ rows|length != 1 ? 's' }} · articles liés par leurs tarifs d’achat, archivés inclus.</p>
<div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Fournisseur</th><th>Alias / libellé interne</th><th>Articles</th><th>Actions</th></tr></thead><tbody>
{% for supplier in rows %}<tr><td><a href="{{ path('supplier_show', {id:supplier.id, draft:draftToken}) }}"><strong>{{ supplier.name }}</strong></a></td>
<td>{% if supplier.aliases %}<div>{{ supplier.aliases|join(', ') }}</div>{% endif %}<small class="text-secondary">{{ supplier.reportingLabel }}</small></td>
<td>{{ counts[supplier.id]|default(0) }}</td><td class="text-nowrap"><a href="{{ path('supplier_show', {id:supplier.id, draft:draftToken}) }}">Voir produits</a><br><a href="{{ path('supplier_edit', {id:supplier.id, draft:draftToken}) }}">Modifier</a></td></tr>
{% else %}<tr><td colspan="4" class="p-4">{{ query ? 'Aucun fournisseur ne correspond à la recherche.' : 'Aucun fournisseur enregistré. Ajoutez le premier fournisseur.' }}</td></tr>{% endfor %}
</tbody></table></div>
</section></div>
{% endblock %}
