{% extends 'base.html.twig' %}
{% block body %}
    <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
        <h1>Livraisons</h1>
        <a class="btn btn-success" href="{{ path('delivery_new') }}">Nouvelle livraison</a>
    </div>
    <div class="card table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Client</th>
                    <th>Brut</th>
                    <th>Remise</th>
                    <th>Net</th>
                    <th>Détail</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.date|date('d/m/Y') }}</td>
                        <td>{{ row.client_name }}</td>
                        <td class="money">{{ row.gross_cents|mad }}</td>
                        <td class="money">{{ row.discount_cents|mad }}</td>
                        <td class="money">{{ (row.gross_cents - row.discount_cents)|mad }}</td>
                        <td>
                            <a href="{{ path('delivery_show', {id:row.id}) }}">Livraison #{{ row.id }} et retours</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucune livraison.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
