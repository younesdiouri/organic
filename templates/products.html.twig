{% extends 'base.html.twig' %}
{% block body %}
{% if completionMode %}<a href="{{ path('catalogue_completion') }}">← Articles à compléter</a>{% endif %}
<div class="d-flex justify-content-between align-items-center gap-3 mb-3"><h1 class="mb-0">Catalogue</h1><a class="btn btn-success" href="{{ path('catalogue_completion') }}">Articles à compléter</a></div>
<p>Matières premières, préparations, plats et emballages partagent le même référentiel.</p>
<div class="row g-4">
<div class="col-lg-4 {{ editing ? 'order-1' : 'order-2 order-lg-1' }}"><div class="card p-3">
<h2 class="h5">{{ editing ? 'Modifier l’article' : 'Ajouter un article' }}</h2>
{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-success">Enregistrer</button>
{% if editing %}<a class="btn btn-link" href="{{ path(completionMode ? 'product_complete' : 'product_show',{id:product.id}) }}">Recette et achats</a>{% endif %}
{{ form_end(form) }}</div></div>
<div class="col-lg-8 {{ editing ? 'order-2' : 'order-1 order-lg-2' }}">
<form method="get" class="card p-3 mb-3 d-flex gap-2">
<label for="q">Rechercher</label><input id="q" name="q" class="form-control" value="{{ query }}" placeholder="Nom, référence ou alias">
<label for="kind">Type</label><select id="kind" name="kind" class="form-select"><option value="">Tous</option>{% for label,value in kinds %}<option value="{{ value }}" {{ kind == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select>
<label for="delivery">Livraison</label><select id="delivery" name="delivery" class="form-select"><option value="">Tous</option><option value="1" {{ delivery == '1' ? 'selected' }}>Disponibles</option><option value="0" {{ delivery == '0' ? 'selected' }}>Indisponibles / archivés</option></select>
<button class="btn btn-outline-success">Filtrer</button></form>
<div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Article</th><th>Type</th><th>Vente</th><th>Actions</th></tr></thead><tbody>
{% for row in rows %}<tr><td><a href="{{ path('product_show',{id:row.id}) }}">{{ row.name }}</a>{% if row.code %}<small class="d-block">{{ row.code }}</small>{% endif %}<small class="d-block">{{ row.category }} · {{ row.unit }}</small>{% if not row.active %}<span class="badge text-bg-secondary">Archivé</span>{% endif %}</td><td>{{ kinds|filter(v => v == row.kind)|keys|first }}</td><td>{% if row.sellable %}{{ row.priceCents|mad }}{% endif %}{% if row.deliveryAvailable %}<small class="d-block">Livraison</small>{% endif %}</td><td><a href="{{ path('product_edit',{id:row.id}) }}">Modifier</a><br><a href="{{ path('product_show',{id:row.id}) }}">Recette / achats</a></td></tr>
{% else %}<tr><td colspan="4">Aucun article.</td></tr>{% endfor %}
</tbody></table></div></div></div>
{% endblock %}
