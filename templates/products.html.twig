{% extends 'base.html.twig' %}
{% block body %}
{% if completionMode %}<a href="{{ path('catalogue_completion') }}">← Articles à compléter</a>{% endif %}
{% include '_catalogue_navigation.html.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><h1 class="mb-0">{{ title }}</h1><a class="btn btn-outline-success" href="{{ path('catalogue_completion',{kind:kind}) }}">Articles à compléter</a></div>
<p>{{ {dish:'Les produits proposés aux clients, classés par catégorie. La disponibilité en livraison se règle pour chaque produit.',ingredient:'Les matières premières et leurs tarifs fournisseurs.',preparation:'Les sauces, bases et fabrications maison utilisées dans les recettes.',packaging:'Les contenants et accessoires utilisés pour les livraisons.'}[kind] }}</p>
{% if kind == 'dish' %}
<nav aria-label="Familles de la carte" class="d-flex flex-wrap gap-2 mb-3">
{% for value,label in {'':'Toute la carte',cuisine:'Cuisine',boissons:'Boissons',desserts:'Desserts','a-classer':'À classer'} %}
<a class="btn {{ family == value ? 'btn-success' : 'btn-outline-success' }}" {{ family == value ? 'aria-current="page"' }} href="{{ path('products',listParameters|filter((v,k) => k not in ['family','category','page','completion'])|merge(value ? {family:value} : {})) }}">{{ label }}</a>
{% endfor %}
</nav>
{% endif %}
<details class="card p-3 mb-4" {{ editing or form.vars.submitted ? 'open' }}>
<summary class="h5 mb-0">{{ editing ? 'Modifier l’article' : {dish:'Ajouter un produit',ingredient:'Ajouter un ingrédient',preparation:'Ajouter une préparation',packaging:'Ajouter un emballage'}[kind] }}</summary>
<div class="mt-3">
<h2 class="h5">{{ editing ? 'Modifier l’article' : 'Ajouter un article' }}</h2>
{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-success">Enregistrer</button>
{% if editing %}<a class="btn btn-link" href="{{ path(completionMode ? 'product_complete' : 'product_show',{id:product.id}|merge(completionMode ? {} : listParameters)) }}">Recette et achats</a>{% endif %}
{{ form_end(form) }}</div></details>
<form method="get" class="card p-3 mb-3">
{% if completionMode %}<input type="hidden" name="completion" value="1">{% endif %}
{% if kind != 'dish' %}<input type="hidden" name="kind" value="{{ kind }}">{% endif %}
{% if family %}<input type="hidden" name="family" value="{{ family }}">{% endif %}
<div class="row g-3 align-items-end">
<div class="{{ kind == 'dish' ? 'col-md-5' : 'col-md-7' }}"><label for="q" class="form-label">Rechercher</label><input id="q" name="q" class="form-control" value="{{ query }}" placeholder="Nom, référence ou alias"></div>
<div class="{{ kind == 'dish' ? 'col-md-3' : 'col-md-4' }}"><label for="category" class="form-label">Catégorie</label><select id="category" name="category" class="form-select"><option value="">Toutes</option>{% for value in categories %}{% set categoryValue = value ?: '__uncategorized' %}<option value="{{ categoryValue }}" {{ category == categoryValue ? 'selected' }}>{{ categoryLabels[value]|default(value ?: 'Sans catégorie') }}</option>{% endfor %}</select></div>
{% if kind == 'dish' %}
<div class="col-md-3"><label for="delivery" class="form-label">Livraison</label><select id="delivery" name="delivery" class="form-select"><option value="">Tous</option><option value="1" {{ delivery == '1' ? 'selected' }}>Disponibles</option><option value="0" {{ delivery == '0' ? 'selected' }}>Indisponibles / archivés</option></select></div>
{% elseif delivery %}<input type="hidden" name="delivery" value="{{ delivery }}">{% endif %}
<div class="col-md-1"><button class="btn btn-outline-success w-100">Filtrer</button></div>
</div></form>
{% include '_catalogue_pagination.html.twig' %}
<div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ kind == 'dish' ? 'Produit de la carte' : 'Article' }}</th>{% if kind == 'dish' %}<th>Vente</th>{% endif %}<th>Actions</th></tr></thead><tbody>
{% for row in rows %}<tr><td><a href="{{ path('product_show',{id:row.id}|merge(listParameters|filter((v,k) => k != 'completion'))) }}">{{ row.name }}</a>{% if row.code %}<small class="d-block">{{ row.code }}</small>{% endif %}<small class="d-block">{{ categoryLabels[row.category]|default(row.category ?: 'Sans catégorie') }} · {{ row.unit }}</small>{% if not row.active %}<span class="badge text-bg-secondary">Archivé</span>{% endif %}{% if row.kind in ['dish','preparation'] and not row.recipeComplete %} <span class="badge text-bg-warning">Recette à vérifier</span>{% endif %}</td>{% if kind == 'dish' %}<td>{% if row.sellable %}{{ row.priceCents|mad }}{% else %}<small>Non vendu</small>{% endif %}{% if row.deliveryAvailable %}<small class="d-block">Livraison</small>{% elseif row.sellable %}<small class="d-block">Indisponible en livraison</small>{% endif %}</td>{% endif %}<td><a href="{{ path('product_edit',{id:row.id}|merge(listParameters)) }}">Modifier</a><br><a href="{{ path('product_show',{id:row.id}|merge(listParameters|filter((v,k) => k != 'completion'))) }}">{{ kind in ['ingredient','packaging'] ? 'Achats et fournisseurs' : (kind == 'preparation' ? 'Recette' : 'Fiche technique') }}</a></td></tr>
{% else %}<tr><td colspan="{{ kind == 'dish' ? 3 : 2 }}">Aucun article.</td></tr>{% endfor %}
</tbody></table></div>
{% include '_catalogue_pagination.html.twig' with {paginationSuffix:'-bottom'} %}
{% endblock %}
